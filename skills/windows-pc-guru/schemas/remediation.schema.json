{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/remediation.schema.json",
  "title": "Windows PC Guru Remediation Catalog",
  "type": "object",
  "required": ["SchemaVersion", "ExecutionPolicy", "Remediations"],
  "properties": {
    "SchemaVersion": { "const": "2.0" },
    "ExecutionPolicy": { "const": "GuidedByDefault" },
    "Remediations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "Id", "FindingIds", "Title", "Risk", "Reversibility",
          "RequiresAdmin", "RestartRequired", "ExecutionMode",
          "ExpectedBenefit", "Validation", "Compatibility"
        ],
        "properties": {
          "Id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
          "FindingIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "Title": { "type": "string", "minLength": 10 },
          "Risk": { "type": "string", "pattern": "^G[0-4]$" },
          "Reversibility": { "type": "string", "pattern": "^R[0-3]$" },
          "RequiresAdmin": { "type": "boolean" },
          "RestartRequired": { "type": "boolean" },
          "ExecutionMode": { "enum": ["ManualGuided", "ControlledAutomatic"] },
          "ExpectedBenefit": { "type": "string", "minLength": 10 },
          "Validation": { "type": "string", "minLength": 10 },
          "Compatibility": {
            "type": "object",
            "required": ["OsFamilies", "Editions", "Architectures", "DeviceTypes", "MinBuild", "MaxBuild", "RequiredCapabilities"],
            "properties": {
              "OsFamilies": { "type": "array", "minItems": 1, "items": { "enum": ["Windows11"] } },
              "Editions": { "type": "array", "minItems": 1, "items": { "enum": ["Home", "Pro", "ProWorkstations", "ProEducation", "Enterprise", "Education"] } },
              "Architectures": { "type": "array", "minItems": 1, "items": { "enum": ["x64", "arm64"] } },
              "DeviceTypes": { "type": "array", "minItems": 1, "items": { "enum": ["Desktop", "Laptop", "Workstation", "Tablet", "Other"] } },
              "MinBuild": { "type": ["integer", "null"], "minimum": 22000 },
              "MaxBuild": { "type": ["integer", "null"], "minimum": 22000 },
              "RequiredCapabilities": { "type": "array", "items": { "type": "string", "minLength": 3 } }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
